{
  "version": 1,
  "contract": "Every seed template must preserve a distinct domain-native grammar. The test suite reads this file as the canonical machine-readable source for cover classes, cover-scoped objects, full-deck role markers, and forbidden fallback objects. Templates 06-08 (brutalist / memphis / isometric) are implemented seed HTML — three orthogonal styles chosen for maximum differentiation from 01-05. Template 10 (clinical-trial) implements the clinical-lab design grammar from design-polish.md as seed HTML, the first examples/ file to land one of those design-polish grammars. The 9 remaining design-grammar references in design-polish.md (financial-terminal, civic-infrastructure, legal-casefile, luxury-atelier, cinematic-storyboard, motion-sequence, system-flow, code-walkthrough, data-visual-studio) are unimplemented; their 06-15 numbering in design-polish.md is a logical chapter index and does NOT correspond to examples/ filenames.",
  "templates": {
    "examples/template-01-editorial-serif.html": {
      "domain": "archive / editorial research",
      "designGrammar": "archive desk, evidence wall, plate reading, quote judgment",
      "coverClass": "archive-cover",
      "coverObjects": [
        "poster-wall",
        "paper",
        "stamp",
        "rule"
      ],
      "deckObjects": [
        "archive-cover",
        "folio-grid",
        "plate-grid",
        "quote-page",
        "closing"
      ],
      "roleMarkers": {
        "cover": "archive-cover",
        "proof": "folio-grid",
        "mechanism": "plate-grid",
        "close": "closing"
      },
      "forbidden": []
    },
    "examples/template-02-dark-tech.html": {
      "domain": "control room / technical operations",
      "designGrammar": "live ops console, radar proof, telemetry signal, incident simulation",
      "coverClass": "control-cover",
      "coverObjects": [
        "ops-copy",
        "terminal",
        "control-radar",
        "radar-blip"
      ],
      "deckObjects": [
        "control-cover",
        "ops-map",
        "signal-page",
        "incident",
        "status-grid"
      ],
      "roleMarkers": {
        "cover": "control-cover",
        "proof": "ops-map",
        "mechanism": "signal-page",
        "close": "status-grid"
      },
      "physicalContract": {
        "version": 1,
        "purpose": "The ops console is a physical monitoring surface: the terminal panel must own its readout lines, and the console must not collide with the headline copy. Radar and blips are a decorative layer (data-qa-ignore) and stay outside ownership checks.",
        "surfaceRules": [
          {
            "name": "terminal-owns-readout-lines",
            "surface": ".terminal",
            "contents": [
              ".term-bar",
              ".line"
            ],
            "maxSpillPx": 2,
            "requireOwnership": true
          }
        ],
        "exclusionRules": [
          {
            "name": "terminal-must-not-cover-headline-copy",
            "a": ".terminal",
            "b": ".cover-body",
            "maxIntersectionArea": 1
          }
        ],
        "collisionRules": [
          {
            "name": "cursor-does-not-cover-readout-keys",
            "scope": ".terminal",
            "a": ".cursor",
            "b": ".key",
            "bTextPattern": "eu-|us-|ap-",
            "maxIntersectionWidthPx": 2,
            "maxIntersectionHeightPx": 2
          }
        ]
      },
      "forbidden": []
    },
    "examples/template-03-minimal-spatial.html": {
      "domain": "architecture / spatial product narrative",
      "designGrammar": "architectural plate, title block, dimension chains, measured floor plan, section cut",
      "coverClass": "spatial-cover",
      "coverObjects": [
        "blueprint-sheet",
        "plan-drawing",
        "dimension-chain",
        "plate-notes",
        "title-block",
        "north-mark"
      ],
      "deckObjects": [
        "section-cut",
        "cutaway",
        "matrix",
        "void-page",
        "route"
      ],
      "roleMarkers": {
        "cover": "spatial-cover",
        "proof": "section-cut",
        "mechanism": "matrix",
        "close": "void-page"
      },
      "physicalContract": {
        "version": 1,
        "purpose": "Architectural plates are physical drawing sheets: the grid field, plan, dimensions, notes, bottom title band, and title block must use declared ownership and collision rules rather than independent absolute coordinates.",
        "surfaceRules": [
          {
            "name": "blueprint-field-owns-drawing-objects",
            "surface": ".blueprint-sheet",
            "contents": [
              ".plan-drawing",
              ".dimension-chain",
              ".plate-notes"
            ],
            "maxSpillPx": 2,
            "requireOwnership": true
          },
          {
            "name": "bottom-band-owns-title-objects",
            "surface": ".cover-bottom",
            "contents": [
              ".cover-title-area",
              ".title-block"
            ],
            "maxSpillPx": 2,
            "requireOwnership": true
          }
        ],
        "exclusionRules": [
          {
            "name": "title-block-must-not-enter-grid-field",
            "a": ".title-block",
            "b": ".blueprint-sheet",
            "maxIntersectionArea": 1
          }
        ],
        "alignmentRules": [
          {
            "name": "dimension-chain-aligns-with-outer-wall",
            "type": "horizontalEdges",
            "subject": ".dimension-chain",
            "target": ".plan-drawing svg rect[stroke-width=\"3\"]",
            "maxDeltaPx": 10
          }
        ],
        "placementRules": [
          {
            "name": "plan-stays-left-up-inside-grid-field",
            "subject": ".plan-drawing",
            "container": ".blueprint-sheet",
            "maxLeftInsetPx": 150,
            "maxTopInsetPx": 170,
            "minBottomClearancePx": 40
          }
        ],
        "collisionRules": [
          {
            "name": "plan-markers-do-not-cover-room-labels",
            "scope": ".plan-drawing",
            "a": "svg circle[fill=\"var(--c-accent)\"]",
            "b": "svg text",
            "bTextPattern": "FOYER|READING|CORE|STUDIO|WORK",
            "maxIntersectionWidthPx": 2,
            "maxIntersectionHeightPx": 2
          }
        ]
      },
      "forbidden": [
        "block a",
        "block b",
        "block c"
      ]
    },
    "examples/template-04-vibrant-gradient.html": {
      "domain": "brand launch / live community keynote",
      "designGrammar": "live keynote stage, giant screen, countdown ticker, audience floor, camera frame, product drop",
      "coverClass": "launch-cover",
      "coverObjects": [
