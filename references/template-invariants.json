    "examples/template-09-editorial-photo.html": {
      "domain": "city / travel / real-estate / food / product photography (image-as-content)",
      "designGrammar": "editorial photo spread, full-bleed hero overlay, photo grid gallery, photo+stat anchor, muted filter unified across deck",
      "coverClass": "ph-cover",
      "coverObjects": [
        "hero-img",
        "cover-content",
        "cover-deck",
        "cover-meta"
      ],
      "deckObjects": [
        "img-side",
        "text-side",
        "num-side",
        "gallery",
        "cell",
        "section-content"
      ],
      "roleMarkers": {
        "cover": "ph-cover",
        "section": "ph-section",
        "spread": "ph-spread",
        "gallery": "ph-grid-page",
        "stat": "ph-stat",
        "credits": "ph-credits",
        "proof": "ph-stat",
        "mechanism": "ph-spread",
        "close": "ph-credits"
      },
      "physicalContract": {
        "version": 1,
        "purpose": "The hero photo is a full-bleed physical print: the gradient overlay and cover typography sit on top of it (photo and overlay are data-qa-ignore decorative layers), cover content must own its type, and corner furniture must not collide with the headline layer.",
        "surfaceRules": [
          {
            "name": "cover-content-owns-cover-typography",
            "surface": ".cover-content",
            "contents": [
              ".kicker",
              "h1",
              ".cover-deck",
              ".cover-meta"
            ],
            "maxSpillPx": 2,
            "requireOwnership": true
          }
        ],
        "exclusionRules": [
          {
            "name": "cover-stamp-must-not-enter-cover-code",
            "a": ".cover-stamp",
            "b": ".cover-code",
            "maxIntersectionArea": 1
          }
        ],
        "collisionRules": [
          {
            "name": "stamp-does-not-cover-headline",
            "scope": ".ph-cover",
            "a": ".cover-stamp",
            "b": "h1",
            "bTextPattern": "城市|City|照片",
            "maxIntersectionWidthPx": 2,
            "maxIntersectionHeightPx": 2
          }
        ]
      },
      "forbidden": [
        "hero-img bare",
        "stock-photo"
      ],
      "forbiddenProse": [
        "bare photo without overlay/filter: every photo must carry a treatment class (hero-img overlay, section-dim, or muted-img) plus its gradient overlay; no raw bare photo ships",
        "stock-photo staging: no staged stock-photo semantics (see image-driven-deck.md selection rules); the photo is the proof object"
      ]
    },
    "examples/template-10-clinical-trial.html": {
      "domain": "clinical trial / regulatory dossier",
      "designGrammar": "clinical evidence binder, dossier masthead, treatment/control arm rail, endpoint stamp, trial design matrix, response stack (CR/PR/SD/PD), Kaplan-Meier survival curve, subgroup forest plot, safety matrix",
      "coverClass": "dossier-cover",
      "coverObjects": [
        "dossier-masthead",
        "arm-rail",
        "endpoint-stamp",
        "dossier-meta",
        "dose-bar"
      ],
      "deckObjects": [
        "trial-schema",
        "baseline-table",
        "response-stack",
        "km-curve",
        "forest-plot",
        "ae-matrix"
      ],
      "roleMarkers": {
        "cover": "dossier-cover",
        "proof": "response-stack",
        "mechanism": "km-curve",
        "close": "dossier-close"
      },
      "physicalContract": {
        "version": 1,
        "purpose": "The KM curve and forest plot are measured coordinate systems: every axis label, curve, and marker stays inside its plot viewport, median markers and point estimates must not cover value labels, and the reading column must not intrude into the plot panel.",
        "surfaceRules": [
          {
            "name": "plot-viewport-owns-coordinate-marks",
            "surface": "svg",
            "contents": [
              "svg text",
              "svg circle",
              "svg polyline",
              "svg rect"
            ],
            "maxSpillPx": 2,
            "requireOwnership": true
          }
        ],
        "exclusionRules": [
          {
            "name": "reading-column-must-not-enter-plot-panel",
            "a": ".anchor-num",
            "b": "svg",
            "maxIntersectionArea": 1
          }
        ],
        "collisionRules": [
          {
            "name": "median-marker-does-not-cover-curve-label",
            "scope": ".km-curve",
            "a": "svg circle[fill=\"var(--c-drug)\"]",
            "b": "svg text",
            "bTextPattern": "mo|Months",
            "maxIntersectionWidthPx": 2,
            "maxIntersectionHeightPx": 2
          },
          {
            "name": "point-estimate-does-not-cover-hr-value",
            "scope": ".forest-plot",
            "a": "svg rect[fill=\"var(--c-drug)\"]",
            "b": "svg text",
            "bTextPattern": "^0\\.",
            "maxIntersectionWidthPx": 2,
            "maxIntersectionHeightPx": 2
          }
        ]
      },
      "forbidden": []
    }
