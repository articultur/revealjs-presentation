        "drop",
        "totem-grid"
      ],
      "roleMarkers": {
        "cover": "launch-cover",
        "proof": "impact",
        "mechanism": "chat",
        "close": "launch-close"
      },
      "physicalContract": {
        "version": 1,
        "purpose": "The keynote stage is a physical venue: the main screen hangs inside the stage scene above the audience floor, the camera frame must align with the screen it shoots, and broadcast copy must stay on its screen surface.",
        "surfaceRules": [
          {
            "name": "main-screen-owns-broadcast-copy",
            "surface": ".main-screen",
            "contents": [
              ".screen-tag",
              "h1",
              ".sub"
            ],
            "maxSpillPx": 2,
            "requireOwnership": true
          },
          {
            "name": "camera-frame-owns-rec-readouts",
            "surface": ".camera-frame",
            "contents": [
              ".rec",
              ".timecode"
            ],
            "maxSpillPx": 2,
            "requireOwnership": true
          }
        ],
        "alignmentRules": [
          {
            "name": "camera-frame-aligns-with-main-screen",
            "type": "horizontalEdges",
            "subject": ".camera-frame",
            "target": ".main-screen",
            "maxDeltaPx": 2
          }
        ],
        "placementRules": [
          {
            "name": "main-screen-hangs-inside-stage-scene",
            "subject": ".main-screen",
            "container": ".stage-scene",
            "maxLeftInsetPx": 170,
            "maxTopInsetPx": 40,
            "minBottomClearancePx": 60
          }
        ]
      },
      "forbidden": []
    },
